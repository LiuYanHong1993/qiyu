# 契语实验 · 真模型接入配置
# 用法：把本文件复制为同目录下的 .env，填入两个值即可。
#   copy .env.example .env
# 注意：.env 含密钥——不要提交到 git、不要截图发给别人。

# 任何 OpenAI 兼容接口（harness 会在后面自动拼 /chat/completions），例如：
#   OpenAI:   https://api.openai.com/v1
#   DeepSeek: https://api.deepseek.com/v1
#   Moonshot: https://api.moonshot.cn/v1
#   智谱:     https://open.bigmodel.cn/api/paas/v4
QIYU_EXP_BASE_URL=

# 你的 API Key
QIYU_EXP_API_KEY=
