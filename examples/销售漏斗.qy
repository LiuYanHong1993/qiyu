# T09 · 销售漏斗统计 —— 契语参考实现
工具 销售漏斗 {
  说明 "从 CRM 导出统计各阶段漏斗（枚举保序、缺阶段补零、转化率以线索为分母）"
  能力 读 "~/leads.json"
  能力 写 "~/funnel.json"

  保证 线索表.行数 > 0

  记录   = 读记录("~/leads.json")
  线索表 = 列表成表格(记录)
  分段   = 汇总 线索表 按 阶段 { 客户数 = 计数(), 金额合计 = 求和(金额) }
  线索数 = 查找(分段, "阶段", "线索").客户数
  漏斗   = 空表("阶段", "客户数", "金额合计", "转化率")
  对每个 阶段名 在 ["线索", "意向", "方案", "成交"] {
    命中 = 查找(分段, "阶段", 阶段名)
    若 为空(命中) {
      漏斗 = 加入行(漏斗, [阶段名, 0, 0, 0.00])
    } 否则 {
      漏斗 = 加入行(漏斗, [阶段名, 命中.客户数, 命中.金额合计, 四舍五入(命中.客户数 / 线索数, 2)])
    }
  }
  存JSON 漏斗 "阶段" 到 "~/funnel.json"
  返回 漏斗
}
