# T13 · 脏数据清洗 —— 契语参考实现
工具 数据清洗 {
  说明 "按显式规则清洗：金额去¥与千分位、日期三格式归一、品名去空格、全行去重（保留首次），输出干净表+逐列报告"
  能力 读 "~/dirty.csv"
  能力 写 "~/"

  保证 干净表.行数 > 0

  脏表     = 读表格("~/dirty.csv")
  干净表   = 空表("品名", "日期", "金额", "城市")
  金额修正 = 0
  日期修正 = 0
  品名去空 = 0
  对每个 行 在 脏表 {
    品名 = 切除(行.品名)
    城市 = 切除(行.城市)
    若 行.品名 != 品名 { 品名去空 = 品名去空 + 1 }
    金额文本 = 切除(行.金额)
    若 金额文本 == "" {
      金额值 = ""
    } 否则 {
      金额标准 = 正则替换(金额文本, "[¥,]", "")
      若 金额标准 != 金额文本 { 金额修正 = 金额修正 + 1 }
      金额值 = 转数字(金额标准)
    }
    日期文本 = 切除(行.日期)
    若 日期文本 == "" {
      日期值 = ""
    } 否则 {
      日期标准 = 标准日期(日期文本)
      若 日期标准 != 日期文本 { 日期修正 = 日期修正 + 1 }
      日期值 = 日期标准
    }
    干净表 = 加入行(干净表, [品名, 日期值, 金额值, 城市])
  }
  干净表 = 去重(干净表)
  去重数 = 脏表.行数 - 干净表.行数
  报告 = 空表("列名", "操作", "数量")
  若 金额修正 > 0 { 报告 = 加入行(报告, ["金额", "格式修正", 金额修正]) }
  若 日期修正 > 0 { 报告 = 加入行(报告, ["日期", "格式修正", 日期修正]) }
  若 品名去空 > 0 { 报告 = 加入行(报告, ["品名", "去空格", 品名去空]) }
  若 去重数 > 0 { 报告 = 加入行(报告, ["全表", "去重", 去重数]) }
  存表格 干净表 到 "~/clean.csv"
  存表格 报告 到 "~/report.csv"
}
