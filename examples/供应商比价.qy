# T16 · 供应商比价 —— 契语参考实现
工具 供应商比价 {
  说明 "三表合并后按规则选优：起订量≤需求 且 交期≤7天 中报价最低；平价取供应商名字母序；无候选→需人工"
  能力 读 "~/supplier_a.csv"
  能力 读 "~/supplier_b.csv"
  能力 读 "~/supplier_c.csv"
  能力 读 "~/needs.csv"
  能力 写 "~/"

  保证 需求表.行数 > 0

  甲表 = 派生 读表格("~/supplier_a.csv") { 供应商 = "甲" }
  乙表 = 派生 读表格("~/supplier_b.csv") { 供应商 = "乙" }
  丙表 = 派生 读表格("~/supplier_c.csv") { 供应商 = "丙" }
  全部   = 连接(连接(甲表, 乙表), 丙表)
  需求表 = 读表格("~/needs.csv")
  建议   = 空表("SKU", "建议供应商", "报价", "状态")
  对每个 需求 在 需求表 {
    最优 = 空
    对每个 报价 在 全部 {
      若 报价.SKU == 需求.SKU 且 报价.起订量 <= 需求.需求量 且 报价.交期天 <= 7 {
        若 为空(最优) {
          最优 = 报价
        } 否则 {
          若 报价.报价 < 最优.报价 或 (报价.报价 == 最优.报价 且 报价.供应商 < 最优.供应商) {
            最优 = 报价
          }
        }
      }
    }
    若 为空(最优) {
      建议 = 加入行(建议, [需求.SKU, "", "", "需人工"])
    } 否则 {
      建议 = 加入行(建议, [需求.SKU, 最优.供应商, 最优.报价, "已选"])
    }
  }
  建议 = 排列 建议 按 SKU 升序
  存表格 建议 到 "~/advice.csv"
  返回 建议
}
