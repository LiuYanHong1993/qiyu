# T19 · 邮件附件归档 —— 契语参考实现
工具 附件归档 {
  说明 "读取 mock 收件箱：主题含'对账单'的附件按发件人域名归档并登记，重名用邮件时间戳"
  能力 读 "~/inbox.json"
  能力 读 "~/归档/"
  能力 写 "~/归档/"
  能力 写 "~/register.csv"

  保证 收件箱.条数 > 0

  收件箱 = 读记录("~/inbox.json")
  登记   = 空表("发件人", "主题", "保存路径")
  对每个 邮件 在 收件箱 {
    若 含(邮件.主题, "对账单") {
      域名   = 取段(邮件.发件人, "@", 2)
      时间戳 = 替换(中取(邮件.日期, 12, 19), ":", "")
      对每个 附件 在 邮件.附件 {
        目标 = "~/归档/" + 域名 + "/" + 附件.文件名
        若 文件存在(目标) {
          目标 = "~/归档/" + 域名 + "/" + 取段(附件.文件名, ".", 1) + "_" + 时间戳 + "." + 取段(附件.文件名, ".", 2)
        }
        写文本 附件.内容 到 目标
        登记 = 加入行(登记, [邮件.发件人, 邮件.主题, 目标])
      }
    }
  }
  登记 = 排列 登记 按 保存路径 升序
  存表格 登记 到 "~/register.csv"
}
