# T17 · 客户分层标签 —— 契语参考实现
工具 客户分层 {
  说明 "按消费额与最后消费时间打标签（规则按序、首条生效：沉睡优先于消费额）"
  参数 today: 文本

  能力 读 "~/customers.csv"
  能力 写 "~/"

  保证 分层.行数 > 0

  台账 = 读表格("~/customers.csv")
  分层 = 空表("客户", "年度消费", "最近消费日", "标签")
  对每个 行 在 台账 {
    未跟进天数 = 日期差(参数.today, 行.最近消费日)
    若 未跟进天数 > 365 {
      标签 = "沉睡"
    } 否则 {
      若 行.年度消费 >= 100000 {
        标签 = "VIP"
      } 否则 {
        若 行.年度消费 >= 10000 {
          标签 = "重要"
        } 否则 {
          标签 = "普通"
        }
      }
    }
    分层 = 加入行(分层, [行.客户, 行.年度消费, 行.最近消费日, 标签])
  }
  分层 = 排列 分层 按 客户 升序
  存表格 分层 到 "~/customers_tagged.csv"
  汇总表 = 汇总 分层 按 标签 { 客户数 = 计数() }
  汇总表 = 排列 汇总表 按 标签 升序
  存表格 汇总表 到 "~/segments.csv"
}
