# T06 · 报销对账 —— 契语参考实现
工具 报销对账 {
  说明 "报销单与流水一对一核销：金额精确到分、日期差≤1天、日期就近优先（先到先得）"
  能力 读 "~/expense.csv"
  能力 读 "~/bank.csv"
  能力 写 "~/"

  保证 已配数 * 2 + 未配报销.行数 + 未配流水.行数 == 报销表.行数 + 流水表.行数

  报销表   = 读表格("~/expense.csv")
  流水表   = 读表格("~/bank.csv")
  已用     = 空表("流水行号")
  已配数   = 0
  未配报销 = 空表("行号", "报销人", "金额", "日期", "原因")
  未配流水 = 空表("行号", "流水号", "金额", "日期", "原因")
  对每个 报销 在 报销表 {
    最佳差 = 2
    最佳号 = ""
    命中无 = 真
    对每个 流水 在 流水表 {
      差 = 绝对值(日期差(流水.日期, 报销.日期))
      若 流水.金额 == 报销.金额 且 差 <= 1 且 差 < 最佳差 且 为空(查找(已用, "流水行号", 流水.行号)) {
        最佳差 = 差
        最佳号 = 流水.行号
        命中无 = 假
      }
    }
    若 命中无 {
      未配报销 = 加入行(未配报销, [报销.行号, 报销.报销人, 报销.金额, 报销.日期, "无匹配流水"])
    } 否则 {
      已用   = 加入行(已用, [最佳号])
      已配数 = 已配数 + 1
    }
  }
  对每个 流水 在 流水表 {
    若 为空(查找(已用, "流水行号", 流水.行号)) {
      未配流水 = 加入行(未配流水, [流水.行号, 流水.流水号, 流水.金额, 流水.日期, "无匹配报销"])
    }
  }
  未配报销 = 排列 未配报销 按 行号 升序
  未配流水 = 排列 未配流水 按 行号 升序
  存表格 未配报销 到 "~/unmatched_expense.csv"
  存表格 未配流水 到 "~/unmatched_bank.csv"
  返回 已配数
}
