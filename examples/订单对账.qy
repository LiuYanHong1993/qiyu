# T11 · 电商订单对账 —— 契语参考实现
工具 订单对账 {
  说明 "分页拉取平台订单，与本地发货表对账（平台多/本地多/金额不一致）"
  能力 读 "~/shipments.csv"
  能力 写 "~/"
  能力 请求 "https://api.shop.com/orders"

  保证 差异表.行数 > 0

  订单表 = 分页请求("https://api.shop.com/orders?page={页}&size=100", "orders")
  发货表 = 读表格("~/shipments.csv")
  差异表 = 空表("订单号", "类型", "平台金额", "本地金额")
  对每个 订单 在 订单表 {
    命中 = 查找(发货表, "订单号", 订单.订单号)
    若 为空(命中) {
      差异表 = 加入行(差异表, [订单.订单号, "平台多", 订单.金额, ""])
    } 否则 {
      若 命中.金额 != 订单.金额 {
        差异表 = 加入行(差异表, [订单.订单号, "金额不一致", 订单.金额, 命中.金额])
      }
    }
  }
  对每个 行 在 发货表 {
    若 为空(查找(订单表, "订单号", 行.订单号)) {
      差异表 = 加入行(差异表, [行.订单号, "本地多", "", 行.金额])
    }
  }
  差异表 = 排列 差异表 按 类型 升序, 订单号 升序
  存表格 差异表 到 "~/reconcile.csv"
  返回 差异表
}
