# T05 · 发票归档 —— 契语参考实现
工具 发票归档 {
  说明 "把下载目录的发票 PDF 按年月/供应商归档；同名自动加 _2；写归档日志"
  能力 读 "~/下载/"
  能力 读 "~/归档/"
  能力 写 "~/下载/"
  能力 写 "~/归档/"

  保证 日志.行数 > 0

  日志 = 空表("原路径", "新路径")
  对每个 文件 在 列目录("~/下载/**/*.pdf") {
    供应商 = 取段(文件.名字, "_", 1)
    日期   = 标准日期(取段(文件.名字, "_", 2))
    目标   = "~/归档/" + 左取(日期, 4) + "-" + 中取(日期, 6, 7) + "/" + 供应商 + "/" + 文件.名字
    若 文件存在(目标) {
      目标 = 左取(目标, 长度(目标) - 4) + "_2.pdf"
    }
    移动文件 文件.路径 到 目标
    日志 = 加入行(日志, [文件.路径, 目标])
  }
  存表格 日志 到 "~/归档/archive_log.csv"
}
