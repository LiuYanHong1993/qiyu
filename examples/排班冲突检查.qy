# T14 · 排班冲突检查 —— 契语参考实现
工具 排班检查 {
  说明 "排序后单趟扫描：双班=同人同日≥2条；连班=同人连续≥7天（记录段首日，只报一次）"
  能力 读 "~/shifts.csv"
  能力 写 "~/"

  保证 排班.行数 > 0

  排班 = 排列 读表格("~/shifts.csv") 按 姓名 升序, 日期 升序
  违规 = 空表("类型", "姓名", "日期", "说明")
  前姓名 = ""
  前日期 = ""
  连续 = 1
  对每个 行 在 排班 {
    若 行.姓名 == 前姓名 {
      若 行.日期 == 前日期 {
        违规 = 加入行(违规, ["双班", 行.姓名, 行.日期, "同日多个班次"])
      } 否则 {
        若 日期加(前日期, 1, "日") == 行.日期 {
          连续 = 连续 + 1
          若 连续 == 7 {
            段首 = 日期加(行.日期, -6, "日")
            违规 = 加入行(违规, ["连班", 行.姓名, 段首, "连续 7 天以上有班"])
          }
        } 否则 {
          连续 = 1
        }
      }
    } 否则 {
      连续 = 1
    }
    前姓名 = 行.姓名
    前日期 = 行.日期
  }
  违规 = 排列 违规 按 类型 升序, 姓名 升序, 日期 升序
  存表格 违规 到 "~/violations.csv"
  返回 违规
}
