# T02 · 客户去重合并 —— 契语参考实现
工具 客户合并 {
  说明 "按归一化手机号合并两份客户表；同名冲突挑出复核；保留信息更全的一行（平局取甲）"
  能力 读 "~/crm_a.csv"
  能力 读 "~/crm_b.csv"
  能力 写 "~/"

  保证 主表.行数 > 0

  归甲 = 派生 读表格("~/crm_a.csv") { 手机号键 = 右取(正则替换(行.手机号, "\\D", ""), 11) }
  归乙 = 派生 读表格("~/crm_b.csv") { 手机号键 = 右取(正则替换(行.手机号, "\\D", ""), 11) }
  主表   = 空表("手机号", "客户名", "公司", "邮箱")
  冲突表 = 空表("手机号", "crm_a客户名", "crm_b客户名")
  对每个 行 在 归甲 {
    命中 = 查找(归乙, "手机号键", 行.手机号键)
    若 为空(命中) {
      主表 = 加入行(主表, [行.手机号键, 行.客户名, 行.公司, 行.邮箱])
    } 否则 {
      若 行.客户名 != 命中.客户名 {
        冲突表 = 加入行(冲突表, [行.手机号键, 行.客户名, 命中.客户名])
      }
      甲全 = 转数字(行.客户名 != "") + 转数字(行.公司 != "") + 转数字(行.邮箱 != "")
      乙全 = 转数字(命中.客户名 != "") + 转数字(命中.公司 != "") + 转数字(命中.邮箱 != "")
      若 甲全 >= 乙全 {
        主表 = 加入行(主表, [行.手机号键, 行.客户名, 行.公司, 行.邮箱])
      } 否则 {
        主表 = 加入行(主表, [命中.手机号键, 命中.客户名, 命中.公司, 命中.邮箱])
      }
    }
  }
  对每个 行 在 归乙 {
    若 为空(查找(归甲, "手机号键", 行.手机号键)) {
      主表 = 加入行(主表, [行.手机号键, 行.客户名, 行.公司, 行.邮箱])
    }
  }
  主表 = 排列 主表 按 手机号 升序
  冲突表 = 排列 冲突表 按 手机号 升序
  存表格 主表 到 "~/customers.csv"
  存表格 冲突表 到 "~/conflicts.csv"
}
