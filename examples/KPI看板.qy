# T15 · KPI 看板数据 —— 契语参考实现
工具 KPI看板 {
  说明 "合并目标(万元)/实际(元)/回款(元)三表：单位统一为元，月份并集补全，目标缺失或为0→null"
  能力 读 "~/targets.csv"
  能力 读 "~/actuals.csv"
  能力 读 "~/payments.csv"
  能力 写 "~/kpi.json"

  保证 月表.行数 > 0

  目标表 = 派生 读表格("~/targets.csv") { 目标额_元 = 行.目标额 * 10000 }
  实际表 = 派生 读表格("~/actuals.csv") { 实际额_元 = 行.实际额 }
  回款表 = 派生 读表格("~/payments.csv") { 回款额_元 = 行.回款额 }
  月表   = 空表("月份")
  对每个 行 在 目标表 { 月表 = 加入行(月表, [行.月份]) }
  对每个 行 在 实际表 {
    若 为空(查找(月表, "月份", 行.月份)) { 月表 = 加入行(月表, [行.月份]) }
  }
  对每个 行 在 回款表 {
    若 为空(查找(月表, "月份", 行.月份)) { 月表 = 加入行(月表, [行.月份]) }
  }
  月表 = 排列 月表 按 月份 升序
  看板 = 空表("月份", "目标额_元", "实际额_元", "完成率", "回款率")
  对每个 行 在 月表 {
    目标命中 = 查找(目标表, "月份", 行.月份)
    实际命中 = 查找(实际表, "月份", 行.月份)
    回款命中 = 查找(回款表, "月份", 行.月份)
    若 为空(实际命中) { 实际额值 = 0 } 否则 { 实际额值 = 实际命中.实际额_元 }
    若 为空(回款命中) { 回款额值 = 0 } 否则 { 回款额值 = 回款命中.回款额_元 }
    若 为空(目标命中) 或 目标命中.目标额_元 == 0 {
      看板 = 加入行(看板, [行.月份, "", 实际额值, "", ""])
    } 否则 {
      看板 = 加入行(看板, [行.月份, 目标命中.目标额_元, 实际额值,
                           四舍五入(实际额值 / 目标命中.目标额_元, 4),
                           四舍五入(回款额值 / 目标命中.目标额_元, 4)])
    }
  }
  存JSON 看板 "月份" 到 "~/kpi.json"
}
