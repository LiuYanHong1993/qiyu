# T18 · 异常波动日报 —— 契语参考实现
工具 异常日报 {
  说明 "区域周销量环比检测：|变化率|>0.5 且 本周>1万 记暴涨/暴跌；上周为0记新增；输出排序日报与摘要"
  参数 current_week: 数字

  能力 读 "~/sales_weekly.csv"
  能力 写 "~/"

  保证 异常表.行数 + 新增表.行数 > 0

  周表   = 读表格("~/sales_weekly.csv")
  本周表 = 筛选 周表 条件(行.周 == 参数.current_week)
  上周表 = 筛选 周表 条件(行.周 == 参数.current_week - 1)
  异常表 = 空表("区域", "上周", "本周", "变化率", "类型", "波动值")
  新增表 = 空表("区域", "上周", "本周", "变化率", "类型", "波动值")
  对每个 行 在 本周表 {
    命中 = 查找(上周表, "区域", 行.区域)
    若 为空(命中) 或 命中.金额 == 0 {
      新增表 = 加入行(新增表, [行.区域, 0, 行.金额, "新增", "新增", -1])
    } 否则 {
      变化率 = 四舍五入((行.金额 - 命中.金额) / 命中.金额, 2)
      若 绝对值(变化率) > 0.5 且 行.金额 > 10000 {
        若 变化率 > 0 {
          异常表 = 加入行(异常表, [行.区域, 命中.金额, 行.金额, 变化率, "暴涨", 绝对值(变化率)])
        } 否则 {
          异常表 = 加入行(异常表, [行.区域, 命中.金额, 行.金额, 变化率, "暴跌", 绝对值(变化率)])
        }
      }
    }
  }
  日报 = 连接(异常表, 新增表)
  日报 = 排列 日报 按 波动值 降序, 区域 升序
  日报 = 取列(日报, "区域", "上周", "本周", "变化率", "类型")
  存表格 日报 到 "~/anomaly.csv"
  若 异常表.行数 > 0 {
    统计 = 汇总 派生 异常表 { 一 = 1 } 按 一 { 最大波动 = 最大(波动值) }
    最大波动 = 查找(统计, "一", 1).最大波动
  } 否则 {
    最大波动 = 0
  }
  异常数 = 异常表.行数 + 新增表.行数
  写文本 "异常区域 " + 转文本(异常数) + " 个，最大波动 " + 转文本(最大波动) 到 "~/summary.txt"
}
